   "source": [
    "# Step 6 - Segmentation and Customer Lifetime Value\n",
    "**Objective 4:** group customers into behavioural segments with K-Means on scaled RFM features, and estimate probabilistic Customer Lifetime Value (CLV) using **BG/NBD + Gamma-Gamma**.\n",
    "\n",
    "**How this fits the pipeline (no data leakage):**\n",
    "- Uses the exact **test cut-off (`1 Jul 2011`)** and active customer cohort (**4,313 customers**) from `data/churn_dataset.csv` (`Split == \"test\"`).\n",
    "- **History** = purchases strictly before `1 Jul 2011`. Both K-Means and BG/NBD + Gamma-Gamma use **only** this history.\n",
    "- **Outcome window** = `1 Jul 2011` to `28 Nov 2011` (150 days). Used only at the end to validate our 5-month CLV predictions against actual future spend.\n",
    "\n",
    "**Outputs:**\n",
    "- `data/customer_segments_clv.csv` (one row per active customer at `2011-07-01` with segment, BG/NBD probabilities, and CLV)\n",
    "- `data/segment_summary.csv` (profile table for each segment for the report and dashboard)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-2",
   "metadata": {},
   "source": [
    "## 1. Setup and load"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "cell-3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Removed 3 fully-cancelled mega order line(s)\n",
      "Active customers at 01 Jul 2011 : 4,313\n",
      "Pre-cutoff sales rows used        : 534,812\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "from scipy.optimize import minimize\n",
    "from scipy.special import gammaln, hyp2f1, betaln\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "pd.options.display.float_format = \"{:,.2f}\".format\n",
    "pd.options.display.max_columns = 60\n",
    "plt.rcParams.update({\"figure.figsize\": (10, 4), \"axes.grid\": True, \"grid.alpha\": 0.3,\n",
    "                     \"axes.spines.top\": False, \"axes.spines.right\": False})\n",
    "\n",
    "DATA, FIG = \"data\", \"figures\"\n",
    "os.makedirs(DATA, exist_ok=True)\n",
    "os.makedirs(FIG, exist_ok=True)\n",
    "\n",
    "sales = pd.read_csv(f\"{DATA}/clean_sales.csv\", parse_dates=[\"InvoiceDate\"], dtype={\"StockCode\": str})\n",
    "returns = pd.read_csv(f\"{DATA}/clean_returns.csv\", parse_dates=[\"InvoiceDate\"], dtype={\"StockCode\": str})\n",
    "\n",
    "# Same fix as in Step 2 and Step 3: remove very large order lines that were later cancelled in full\n",
    "big = sales[sales[\"Revenue\"] >= 20000].reset_index()\n",
    "pairs = big.merge(returns.reset_index()[[\"index\", \"CustomerID\", \"StockCode\", \"ReturnQty\", \"InvoiceDate\"]],\n",
    "                  left_on=[\"CustomerID\", \"StockCode\", \"Quantity\"], right_on=[\"CustomerID\", \"StockCode\", \"ReturnQty\"],\n",
    "                  suffixes=(\"\", \"_ret\"))\n",
    "pairs = pairs[pairs[\"InvoiceDate_ret\"] >= pairs[\"InvoiceDate\"]]\n",
    "sales = sales.drop(index=pairs[\"index\"].unique()).sort_values(\"InvoiceDate\").reset_index(drop=True)\n",
    "returns = returns.drop(index=pairs[\"index_ret\"].unique()).sort_values(\"InvoiceDate\").reset_index(drop=True)\n",
    "print(f\"Removed {len(pairs)} fully-cancelled mega order line(s)\")\n",
    "\n",
    "# Load test snapshot (cut-off = 1 Jul 2011) from Step 3\n",
    "TEST_CUTOFF = pd.Timestamp(\"2011-07-01\")\n",
    "CHURN_DAYS = 150\n",
    "\n",
    "churn_all = pd.read_csv(f\"{DATA}/churn_dataset.csv\", parse_dates=[\"SnapshotDate\", \"WindowEnd\"])\n",
    "df_cust = churn_all[churn_all[\"Split\"] == \"test\"].copy().reset_index(drop=True)\n",
    "\n",
    "hist_sales = sales[(sales[\"InvoiceDate\"] < TEST_CUTOFF) & (sales[\"CustomerID\"].isin(df_cust[\"CustomerID\"]))].copy()\n",
    "print(f\"Active customers at {TEST_CUTOFF:%d %b %Y} : {len(df_cust):,}\")\n",
    "print(f\"Pre-cutoff sales rows used        : {len(hist_sales):,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-4",
   "metadata": {},
   "source": [
    "## 2. RFM scaling and choosing K (Silhouette + Elbow)\n",
    "Wholesale B2B `Frequency` and `Monetary` values are heavily right-skewed. We apply `log1p` to `Recency`, `Frequency`, and `Monetary`, standardise them (`StandardScaler`), and evaluate $K \\in \\{2, \\dots, 8\\}$ with **Inertia (Elbow)** and **Silhouette Score**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cell-5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "   K  Inertia  Silhouette\n",
       "0  2 6,579.53        0.44\n",
       "1  3 5,031.12        0.34\n",
       "2  4 3,820.16        0.37\n",
       "3  5 3,208.11        0.33\n",
       "4  6 2,818.41        0.32\n",
       "5  7 2,560.56        0.29\n",
       "6  8 2,317.77        0.29"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "rfm_cols = [\"Recency\", \"Frequency\", \"Monetary\"]\n",
    "X_log = np.log1p(df_cust[rfm_cols])\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X_log)\n",
    "\n",
    "ks = range(2, 9)\n",
    "inertias, silhouettes = [], []\n",
    "\n",
    "for k in ks:\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=20)\n",
    "    labels = km.fit_predict(X_scaled)\n",
    "    inertias.append(km.inertia_)\n",
    "    silhouettes.append(silhouette_score(X_scaled, labels))\n",
    "\n",
    "k_eval = pd.DataFrame({\"K\": list(ks), \"Inertia\": inertias, \"Silhouette\": silhouettes})\n",
    "display(k_eval)\n",
    "\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(11, 4))\n",
    "ax1.plot(ks, inertias, marker=\"o\", lw=2, color=\"tab:blue\")\n",
    "ax1.set_xlabel(\"Number of clusters (K)\"); ax1.set_ylabel(\"Inertia (within-cluster SSE)\")\n",
    "ax1.set_title(\"Elbow Method on Log-Scaled RFM\")\n",
    "\n",
    "ax2.plot(ks, silhouettes, marker=\"s\", lw=2, color=\"tab:orange\")\n",
    "ax2.axvline(4, ls=\"--\", color=\"k\", lw=1, label=\"Chosen K = 4\")\n",
    "ax2.set_xlabel(\"Number of clusters (K)\"); ax2.set_ylabel(\"Silhouette Score\")\n",
    "ax2.set_title(\"Silhouette Score by K\"); ax2.legend()\n",
    "\n",
    "plt.tight_layout(); plt.savefig(f\"{FIG}/20_rfm_kmeans_selection.png\", dpi=120); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-6",
   "metadata": {},
   "source": [
    "## 3. Fit K-Means (K = 4) and profile each segment\n",
    "$K = 4$ gives a clean silhouette score while separating customers into four clear business personas for the retention engine:\n",
    "- **Champions:** high frequency, high spend, recent buyers\n",
    "- **Loyal Regulars:** steady repeat buyers with solid spend\n",
    "- **Promising / Recent:** recent buyers with low order count so far\n",
    "- **At-Risk / Dormant:** long gap since last order, highest churn rate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "cell-7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "              Segment  Customers  Recency_Mean  Frequency_Mean  Monetary_Mean  Monetary_Median  Total_Revenue  AvgOrderValue  ReturnRate  Observed_ChurnRate  Customer_Share_%  Revenue_Share_%\n",
       "0           Champions        698         26.64           19.85      11,032.30         5,399.16   7,700,542.77         502.19        0.02                0.07             16.18            65.80\n",
       "1      Loyal Regulars       1283        159.44            5.42       2,085.69         1,614.39   2,675,935.99         451.34        0.02                0.42             29.75            22.87\n",
       "2  Promising / Recent        715         23.67            3.53       1,001.02           865.68     715,726.95         314.66        0.02                0.34             16.58             6.12\n",
       "3   At-Risk / Dormant       1617        205.72            1.53         377.64           321.65     610,651.36         271.41        0.02                0.70             37.49             5.22"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "K_OPT = 4\n",
    "kmeans = KMeans(n_clusters=K_OPT, random_state=42, n_init=20)\n",
    "df_cust[\"Cluster\"] = kmeans.fit_predict(X_scaled)\n",
    "\n",
    "# Order clusters from strongest RFM to weakest RFM\n",
    "centroids = df_cust.groupby(\"Cluster\").agg(\n",
    "    R_mean=(\"Recency\", \"mean\"),\n",
    "    F_mean=(\"Frequency\", \"mean\"),\n",
    "    M_mean=(\"Monetary\", \"mean\")\n",
    ")\n",
    "centroids[\"Score\"] = (\n",
    "    centroids[\"F_mean\"].rank(ascending=True)\n",
    "    + centroids[\"M_mean\"].rank(ascending=True)\n",
    "    + centroids[\"R_mean\"].rank(ascending=False)\n",
    ")\n",
    "ordered_clusters = centroids.sort_values([\"Score\", \"M_mean\"], ascending=False).index.tolist()\n",
    "segment_names = [\"Champions\", \"Loyal Regulars\", \"Promising / Recent\", \"At-Risk / Dormant\"]\n",
    "cluster_map = dict(zip(ordered_clusters, segment_names))\n",
    "\n",
    "df_cust[\"Segment\"] = df_cust[\"Cluster\"].map(cluster_map)\n",
    "\n",
    "seg_summary = (\n",
    "    df_cust.groupby(\"Segment\")\n",
    "    .agg(\n",
    "        Customers=(\"CustomerID\", \"count\"),\n",
    "        Recency_Mean=(\"Recency\", \"mean\"),\n",
    "        Frequency_Mean=(\"Frequency\", \"mean\"),\n",
    "        Monetary_Mean=(\"Monetary\", \"mean\"),\n",
    "        Monetary_Median=(\"Monetary\", \"median\"),\n",
    "        Total_Revenue=(\"Monetary\", \"sum\"),\n",
    "        AvgOrderValue=(\"AvgOrderValue\", \"mean\"),\n",
    "        ReturnRate=(\"ReturnRate\", \"mean\"),\n",
    "        Observed_ChurnRate=(\"Churn\", \"mean\"),\n",
    "    )\n",
    "    .reindex(segment_names)\n",
    "    .reset_index()\n",
    ")\n",
    "seg_summary[\"Customer_Share_%\"] = seg_summary[\"Customers\"] / len(df_cust) * 100\n",
    "seg_summary[\"Revenue_Share_%\"] = seg_summary[\"Total_Revenue\"] / seg_summary[\"Total_Revenue\"].sum() * 100\n",
    "\n",
    "display(seg_summary)\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(12, 4))\n",
    "colors = [\"#2ca02c\", \"#1f77b4\", \"#ff7f0e\", \"#d62728\"]\n",
    "\n",
    "axes[0].bar(seg_summary[\"Segment\"], seg_summary[\"Customer_Share_%\"], color=colors)\n",
    "axes[0].set_title(\"Share of Customers (%)\"); axes[0].tick_params(axis=\"x\", rotation=25)\n",
    "\n",
    "axes[1].bar(seg_summary[\"Segment\"], seg_summary[\"Revenue_Share_%\"], color=colors)\n",
    "axes[1].set_title(\"Share of Historical Revenue (%)\"); axes[1].tick_params(axis=\"x\", rotation=25)\n",
    "\n",
    "axes[2].bar(seg_summary[\"Segment\"], seg_summary[\"Observed_ChurnRate\"] * 100, color=colors)\n",
    "axes[2].set_title(\"150-Day Churn Rate (%)\"); axes[2].tick_params(axis=\"x\", rotation=25)\n",
    "\n",
    "plt.tight_layout(); plt.savefig(f\"{FIG}/21_segment_profiles.png\", dpi=120); plt.show()"
   ]
  },
