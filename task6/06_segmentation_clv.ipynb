   "source": [
    "## 4. Customer Lifetime Value: BG/NBD + Gamma-Gamma\n",
    "Two years is short for a naive lifetime value formula, so we use **BG/NBD** (to model repeat purchase rate and probability of still being active) plus **Gamma-Gamma** (to model average order value).\n",
    "\n",
    "**Definitions in BG/NBD (`lifetimes` convention):**\n",
    "- `frequency` ($x$): number of **repeat** purchase days (`distinct_purchase_days - 1`)\n",
    "- `recency` ($t_x$): days between first purchase and last purchase (`LastDay - FirstDay`)\n",
    "- `T`: days between first purchase and the cut-off date (`Cutoff - FirstDay`)\n",
    "- `monetary_value` ($m$): mean spend per repeat purchase day (for customers with `frequency > 0`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "cell-9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Customers in BG/NBD table : 4,313\n",
      "Repeat buyers (freq > 0)  : 3,222 (74.7%)\n"
     ]
    }
   ],
   "source": [
    "# Build the daily BG/NBD summary table strictly from pre-cutoff sales\n",
    "OBS_END = TEST_CUTOFF - pd.Timedelta(days=1)\n",
    "\n",
    "daily_sales = (\n",
    "    hist_sales.assign(Day=hist_sales[\"InvoiceDate\"].dt.normalize())\n",
    "    .groupby([\"CustomerID\", \"Day\"], as_index=False)[\"Revenue\"].sum()\n",
    "    .sort_values([\"CustomerID\", \"Day\"])\n",
    ")\n",
    "\n",
    "first_last = daily_sales.groupby(\"CustomerID\").agg(\n",
    "    FirstDay=(\"Day\", \"min\"),\n",
    "    LastDay=(\"Day\", \"max\"),\n",
    "    TotalDays=(\"Day\", \"count\")\n",
    ")\n",
    "first_last[\"frequency\"] = (first_last[\"TotalDays\"] - 1).astype(float)\n",
    "first_last[\"recency\"] = (first_last[\"LastDay\"] - first_last[\"FirstDay\"]).dt.days.astype(float)\n",
    "first_last[\"T\"] = (OBS_END - first_last[\"FirstDay\"]).dt.days.astype(float)\n",
    "\n",
    "# Monetary value = mean revenue of repeat purchase days (excluding the first purchase day)\n",
    "daily_sales[\"IsFirst\"] = ~daily_sales.duplicated(\"CustomerID\", keep=\"first\")\n",
    "repeat_rev = (\n",
    "    daily_sales[~daily_sales[\"IsFirst\"]]\n",
    "    .groupby(\"CustomerID\")[\"Revenue\"].mean()\n",
    "    .rename(\"monetary_value\")\n",
    ")\n",
    "\n",
    "lt_summary = first_last[[\"frequency\", \"recency\", \"T\"]].join(repeat_rev).fillna({\"monetary_value\": 0.0}).reset_index()\n",
    "\n",
    "print(f\"Customers in BG/NBD table : {len(lt_summary):,}\")\n",
    "print(f\"Repeat buyers (freq > 0)  : {(lt_summary['frequency'] > 0).sum():,} ({(lt_summary['frequency'] > 0).mean():.1%})\")\n",
    "display(lt_summary.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "cell-10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BG/NBD params: r=0.8771, alpha=74.7810, a=0.1512, b=7.3706\n",
      "Gamma-Gamma params: p=7.9923, q=2.4599, v=76.6607\n",
      "Spearman correlation (frequency vs monetary_value): 0.247\n"
     ]
    }
   ],
   "source": [
    "# Fit BG/NBD and Gamma-Gamma (uses `lifetimes` if installed, otherwise exact MLE via SciPy)\n",
    "try:\n",
    "    from lifetimes import BetaGeoFitter, GammaGammaFitter\n",
    "    bgf = BetaGeoFitter(penalizer_coef=0.01)\n",
    "    bgf.fit(lt_summary[\"frequency\"], lt_summary[\"recency\"], lt_summary[\"T\"])\n",
    "    lt_summary[\"Prob_Alive\"] = bgf.conditional_probability_alive(\n",
    "        lt_summary[\"frequency\"], lt_summary[\"recency\"], lt_summary[\"T\"]\n",
    "    )\n",
    "    lt_summary[\"Pred_Purchases_150d\"] = bgf.conditional_expected_number_of_purchases_up_to_time(\n",
    "        CHURN_DAYS, lt_summary[\"frequency\"], lt_summary[\"recency\"], lt_summary[\"T\"]\n",
    "    )\n",
    "    lt_summary[\"Pred_Purchases_12m\"] = bgf.conditional_expected_number_of_purchases_up_to_time(\n",
    "        365, lt_summary[\"frequency\"], lt_summary[\"recency\"], lt_summary[\"T\"]\n",
    "    )\n",
    "\n",
    "    rep = lt_summary[(lt_summary[\"frequency\"] > 0) & (lt_summary[\"monetary_value\"] > 0)]\n",
    "    ggf = GammaGammaFitter(penalizer_coef=0.01)\n",
    "    ggf.fit(rep[\"frequency\"], rep[\"monetary_value\"])\n",
    "    lt_summary[\"Expected_Avg_Value\"] = ggf.conditional_expected_average_profit(\n",
    "        lt_summary[\"frequency\"], lt_summary[\"monetary_value\"]\n",
    "    )\n",
    "    lt_summary[\"CLV_5m\"] = ggf.customer_lifetime_value(\n",
    "        bgf, lt_summary[\"frequency\"], lt_summary[\"recency\"], lt_summary[\"T\"],\n",
    "        lt_summary[\"monetary_value\"], time=5, discount_rate=0.01, freq=\"D\"\n",
    "    )\n",
    "    lt_summary[\"CLV_12m\"] = ggf.customer_lifetime_value(\n",
    "        bgf, lt_summary[\"frequency\"], lt_summary[\"recency\"], lt_summary[\"T\"],\n",
    "        lt_summary[\"monetary_value\"], time=12, discount_rate=0.01, freq=\"D\"\n",
    "    )\n",
    "    print(\"Fitted with lifetimes library\")\n",
    "except ImportError:\n",
    "    # Exact Fader, Hardie & Lee (2005) BG/NBD + Gamma-Gamma MLE\n",
    "    x = lt_summary[\"frequency\"].values\n",
    "    t_x = lt_summary[\"recency\"].values\n",
    "    T = lt_summary[\"T\"].values\n",
    "\n",
    "    def bgnbd_neg_ll(log_params):\n",
    "        r, alpha, a, b = np.exp(log_params)\n",
    "        A1 = gammaln(r + x) - gammaln(r) + r * np.log(alpha)\n",
    "        A2 = gammaln(a + b) + gammaln(b + x) - gammaln(b) - gammaln(a + b + x)\n",
    "        A3 = -(r + x) * np.log(alpha + T)\n",
    "        A4 = np.where(x > 0, np.log(a) - np.log(b + np.maximum(x - 1, 0)) - (r + x) * np.log(alpha + t_x), -np.inf)\n",
    "        max_A = np.maximum(A3, A4)\n",
    "        ll = A1 + A2 + max_A + np.log(np.exp(A3 - max_A) + np.where(x > 0, np.exp(A4 - max_A), 0.0))\n",
    "        pen = 0.01 * np.sum( np.exp(log_params) ** 2 )\n",
    "        return -np.sum(ll) + pen\n",
    "\n",
    "    res_bg = minimize(bgnbd_neg_ll, np.log([0.5, 10.0, 0.5, 2.0]), method=\"L-BFGS-B\")\n",
    "    r, alpha, a, b = np.exp(res_bg.x)\n",
    "    print(f\"BG/NBD params: r={r:.4f}, alpha={alpha:.4f}, a={a:.4f}, b={b:.4f}\")\n",
    "\n",
    "    p_alive = 1.0 / (1.0 + np.where(x > 0, (a / (b + np.maximum(x - 1, 0))) * ((alpha + T) / (alpha + t_x)) ** (r + x), 0.0))\n",
    "    lt_summary[\"Prob_Alive\"] = p_alive\n",
    "\n",
    "    def expected_purchases(t):\n",
    "        hyp_term = hyp2f1(r + x, b + x, a + b + x - 1, t / (alpha + T + t))\n",
    "        num = (a + b + x - 1) / (a - 1) * (1.0 - ((alpha + T) / (alpha + T + t)) ** (r + x) * hyp_term)\n",
    "        den = 1.0 + np.where(x > 0, (a / (b + np.maximum(x - 1, 0))) * ((alpha + T) / (alpha + t_x)) ** (r + x), 0.0)\n",
    "        return np.maximum(num / den, 0.0)\n",
    "\n",
    "    lt_summary[\"Pred_Purchases_150d\"] = expected_purchases(CHURN_DAYS)\n",
    "    lt_summary[\"Pred_Purchases_12m\"] = expected_purchases(365.0)\n",
    "\n",
    "    # Gamma-Gamma MLE on repeat buyers\n",
    "    rep = lt_summary[(lt_summary[\"frequency\"] > 0) & (lt_summary[\"monetary_value\"] > 0)]\n",
    "    xr = rep[\"frequency\"].values\n",
    "    mr = rep[\"monetary_value\"].values\n",
    "\n",
    "    def gg_neg_ll(log_params):\n",
    "        p, q, v = np.exp(log_params)\n",
    "        ll = (\n",
    "            gammaln(p * xr + q) - gammaln(p * xr) - gammaln(q)\n",
    "            + q * np.log(v) + (p * xr - 1) * np.log(mr) + (p * xr) * np.log(xr)\n",
    "            - (p * xr + q) * np.log(xr * mr + v)\n",
    "        )\n",
    "        pen = 0.01 * np.sum(np.exp(log_params) ** 2)\n",
    "        return -np.sum(ll) + pen\n",
    "\n",
    "    res_gg = minimize(gg_neg_ll, np.log([2.0, 4.0, 100.0]), method=\"L-BFGS-B\")\n",
    "    p, q, v = np.exp(res_gg.x)\n",
    "    print(f\"Gamma-Gamma params: p={p:.4f}, q={q:.4f}, v={v:.4f}\")\n",
    "\n",
    "    m_all = lt_summary[\"monetary_value\"].values\n",
    "    exp_val = (p * v + p * x * m_all) / (p * x + q - 1)\n",
    "    lt_summary[\"Expected_Avg_Value\"] = exp_val\n",
    "\n",
    "    # Monthly discounted CLV (identical to lifetimes.GammaGammaFitter.customer_lifetime_value)\n",
    "    def compute_clv(months, d=0.01):\n",
    "        clv = np.zeros(len(lt_summary))\n",
    "        for i in range(1, months + 1):\n",
    "            n_purchases = expected_purchases(i * 30.0) - expected_purchases((i - 1) * 30.0)\n",
    "            clv += (n_purchases * exp_val) / ((1.0 + d) ** i)\n",
    "        return clv\n",
    "\n",
    "    lt_summary[\"CLV_5m\"] = compute_clv(5, d=0.01)\n",
    "    lt_summary[\"CLV_12m\"] = compute_clv(12, d=0.01)\n",
    "\n",
    "rep_check = lt_summary[(lt_summary[\"frequency\"] > 0) & (lt_summary[\"monetary_value\"] > 0)]\n",
    "corr_fm = rep_check[\"frequency\"].corr(rep_check[\"monetary_value\"], method=\"spearman\")\n",
    "print(f\"Spearman correlation (frequency vs monetary_value): {corr_fm:.3f}\")\n",
    "display(lt_summary[[\"CustomerID\", \"frequency\", \"recency\", \"T\", \"Prob_Alive\",\n",
    "                    \"Pred_Purchases_150d\", \"Expected_Avg_Value\", \"CLV_5m\", \"CLV_12m\"]].head(10))"
   ]
  },
